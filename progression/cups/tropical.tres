[resource]
script = ExtResource("1")
id = &"tropical"
display_name = "Copa Tropical"
description = "Tres circuitos entre costa, jardín y bahía."
tracks = [ExtResource("t1"), ExtResource("t2"), ExtResource("t3")]
player_racer = ExtResource("r1")
opponents = [ExtResource("r2"), ExtResource("r3"), ExtResource("r4")]
scoring_table = PackedInt32Array(9, 6, 3, 1)
medal_thresholds = PackedInt32Array(9, 17, 24)
difficulties = [ExtResource("d1"), ExtResource("d2"), ExtResource("d3")]
unlocks = [ExtResource("u1"), ExtResource("u2"), ExtResource("u3"), ExtResource("u4"), ExtResource("u5"), ExtResource("u6"), ExtResource("u7"), ExtResource("u8"), ExtResource("u9")]
