[gd_resource type="Resource" script_class="AiTuning" format=3]

[ext_resource type="Script" path="res://scripts/data/ai_tuning.gd" id="1"]

[resource]
script = ExtResource("1")
enable_telemetry_recording = true
telemetry_flush_interval = 30
throttle_deadband = 0.4
brake_deadband = 0.4
drift_curvature_commit = 0.025
drift_curvature_cancel = 0.005
drift_steer_commit = 0.40
drift_steer_cancel = 0.08
drift_lock_frames = 12
